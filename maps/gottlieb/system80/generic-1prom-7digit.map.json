    "player_count": {
      "_notes": "set to 0 when game over",
      "label": "Player Count",
      "short_label": "Players",
      "start": "0x19",
      "encoding": "int"
    },
    "current_player": {
      "_notes": "0-3; bit 7 (0x80) sometimes set.  Also 0x9A w/o 0x80 set?",
      "label": "Current Player",
      "short_label": "P#",
      "start": "0x1D",
      "encoding": "int",
      "mask": "0x0F",
      "offset": 1
    },
    "current_ball": {
