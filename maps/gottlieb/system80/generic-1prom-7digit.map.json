{
  "_notes": [
    "Generic Gottlieb System 80 map for single game PROM games w/7-digit conversion.",
    "NVRAM: 256x4-bit chip (nibble:low) at CPU address 0x1800.",
    "NVRAM: 85-byte regions stored in triplicate at 0x1800, 0x1855, and 0x18AA.",
    "All games share the same bookkeeping/audit and high score layout.",
    "Identical to the non-conversion ROMs, other than scores are 10x."
  ],
  "_fileformat": 0.9,
  "_metadata": {
    "version": 8,
    "copyright": [
      "Copyright (C) 2026 by Tom Collins <tom@scorbit.io>"
    ],
    "license": "Open Data Commons Open Database License (ODbL) v1.0",
    "platform": "gottlieb-system80-1prom",
    "roms": [
      "blkhol7s",
      "blkhole7",
      "eclipse7",
      "forceii7",
      "hh7",
      "jamesb7",
      "jamesb7b",
      "mars7",
      "panther7",
      "pnkpntr7",
      "timelin7",
      "vlcno_a7",
      "vlcno_b7"
    ],
    "validation": {
