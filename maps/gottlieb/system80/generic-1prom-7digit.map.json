      "start": "0x43",
      "encoding": "bcd",
      "mask": "0x0F"
    },
    "max_credits": {
      "_notes": "set at startup from DIP switches",
      "label": "Maximum Credits",
      "start": "0x27",
      "encoding": "bcd"
    },
    "game_over": {
      "_notes": "player_count == 0; maybe 0x1C or 0x72",
      "label": "Game Over",
      "encoding": "bool",
      "start": "0x19",
      "invert": true
    }
  },
